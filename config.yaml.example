# em-data-viewer default configuration
# Install to: ~/.config/em-data-viewer/config.yaml

window:
  width: 400
  keep_above: true
  style:
    background: "#1e1e1eee"
    border_color: "#888888"
    border_width: 1
    # opacity is the window's opacity (0.0-1.0 inclusive); opacity_alt is
    # the value the key toggle switches to.
    opacity: 1.0
    opacity_alt: 0.45

sections:
  - name: clock
    command: "date '+%Y-%m-%d %H:%M:%S'"
    mode: interval
    interval: 1s

  - name: memory
    command: "free -h"
    mode: interval
    interval: 5s

  - name: disk
    command: "df -h /"
    mode: interval
    interval: 30s

  # Stream mode example:
  # - name: log
  #   command: "journalctl -f -n 20 --no-pager -o cat"
  #   mode: stream
  #   max_lines: 50
